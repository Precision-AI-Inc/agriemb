# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real keys. Used by the scripts in examples/ to reach the PAI
# embedding API (https://embeddings.precision.ai/).

# Base URL of the PAI embedding API, including the `/v1` suffix.
PAI_EMBEDDINGS_BASE_URL="https://embeddings.precision.ai/v1"

# Your personal `sk-pai-` API key, minted at <base-url>/keys — for the hosted
# service that is https://embeddings.precision.ai/v1/keys (or use the Portal's
# auto-provisioned Starter key).
PAI_EMBEDDINGS_API_KEY="sk-pai-..."
